-- 1. ЦЕЛЕВОЙ СКРИПТ (ВЫПОЛНЯЕТСЯ ПРИ УСПЕШНОМ КЛЮЧЕ)
-- ==============================================================================
local function runScript()
    print("[VerteX] Key verified! Executing payload...")
    
    local success, err = pcall(function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/ummarxfarooq/mystrix-hub/refs/heads/main/loader"))()
    end)
    
    if not success then
        warn("[VerteX] Error loading main script:", err)
    end
end

-- ==============================================================================
-- 2. НАСТРОЙКИ KEY SYSTEM
-- ==============================================================================
local CONFIG = {
    TITLE    = "VerteX Key System",
    LINK_URL = "https://santil.ink/t/JS5BcYZXQ92EiLXC",
    API_BASE = "https://api.santil.ink/v1",
    KEY_FILE = "vertex_saved_key.txt"
}

local HttpService = game:GetService("HttpService")
local Rayfield    = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local function safeCopy(text)
    if setclipboard then setclipboard(text) elseif toclipboard then toclipboard(text) end
end

-- Проверка ключа через API SantiLink
local function verifyKey(token)
    if not token or #token < 3 then return false, "Please enter a valid key!" end
    
    local url = string.format("%s/keys/verify/%s?consume=false", CONFIG.API_BASE, HttpService:UrlEncode(token:gsub("%s+", "")))
    local ok, res = pcall(function() return game:HttpGet(url) end)
    if not ok or not res then return false, "Connection error to SantiLink." end
    
    local decOk, data = pcall(function() return HttpService:JSONDecode(res) end)
    if not decOk or type(data) ~= "table" then return false, "Invalid API response." end
    
    return (data.verified == true or data.valid == true or data.status == "valid"), data.reason or "Invalid key."
end

-- Окно ввода ключа
local function showKeyUI()
    safeCopy(CONFIG.LINK_URL)

    local Window = Rayfield:CreateWindow({
        Name = CONFIG.TITLE,
        LoadingTitle = "Verification Gateway",
        LoadingSubtitle = "Complete checkpoint to continue",
        ConfigurationSaving = { Enabled = false },
        KeySystem = false
    })

    local Tab = Window:CreateTab("Key System", 4483362458)

    Tab:CreateParagraph({
        Title = "Get Key",
        Content = "1. Link copied to clipboard.\n2. Get key from the link.\n3. Paste key below."
    })

    Tab:CreateButton({
        Name = "🔗 Copy Key Link Again",
        Callback = function()
            safeCopy(CONFIG.LINK_URL)
            Rayfield:Notify({ Title = "Clipboard", Content = "Link copied!", Duration = 2 })
        end
    })

    local inputKey = ""
    Tab:CreateInput({
        Name = "Paste Key Here",
        PlaceholderText = "Enter key...",
        RemoveTextAfterFocusLost = false,
        Callback = function(text) inputKey = text end
    })

    Tab:CreateButton({
        Name = "✓ Verify & Unlock",
        Callback = function()
            if #inputKey == 0 then
                Rayfield:Notify({ Title = "Error", Content = "Please enter key first!", Duration = 3 })
                return
            end

            Rayfield:Notify({ Title = "Verifying...", Content = "Checking key...", Duration = 2 })
            
            task.spawn(function()
                local isValid, msg = verifyKey(inputKey)
                if isValid then
                    if writefile then pcall(function() writefile(CONFIG.KEY_FILE, inputKey:gsub("%s+", "")) end) end
                    Rayfield:Notify({ Title = "Success!", Content = "Key accepted!", Duration = 2 })
                    task.wait(0.7)
                    Rayfield:Destroy()
                    runScript()
                else
                    Rayfield:Notify({ Title = "Failed", Content = msg, Duration = 3 })
                end
            end)
        end
    })
end

-- ==============================================================================
-- 3. АВТО-ВХОД И СТАРТ
-- ==============================================================================
task.spawn(function()
    if isfile and readfile and isfile(CONFIG.KEY_FILE) then
        local ok, saved = pcall(function() return readfile(CONFIG.KEY_FILE) end)
        if ok and saved and #saved > 3 then
            local valid = verifyKey(saved:gsub("%s+", ""))
            if valid then
                runScript()
                return
            else
                if delfile then pcall(function() delfile(CONFIG.KEY_FILE) end) end
            end
        end
    end
    showKeyUI()
end)
